           (expect-status reply 200)
           (unless (string= (header reply "access-control-allow-origin")
                            "https://example.test")
             (fail "origin ~s" (header reply "access-control-allow-origin")))
           (unless (search "origin" (or (header reply "vary") "") :test #'char-equal)
