            (values (subseq packet 6 dcid-end)
                    (subseq packet (1+ dcid-end) scid-end))))))))

(defun quic-retry-test (port)
  "RFC 9000 §17.2.5.1. Retry Destination Connection ID is the client's
Source Connection ID. The server's Source Connection ID is not the
client's Destination Connection ID. One Initial produces one Retry, and
that Retry is at most three times the Initial (RFC 9000 §8.1)."
  (check "a Retry packet chooses a new Source Connection ID"
    (let ((socket (make-instance 'sb-bsd-sockets:inet-socket :type :datagram :protocol :udp))
          (initial (quic-initial-packet 1200)))
      (unwind-protect
           (progn
             (setf (sb-bsd-sockets:non-blocking-mode socket) t)
             (sb-bsd-sockets:socket-send socket initial nil
                                         :address (list #(127 0 0 1) port))
             (let ((reply (quic-recv-packet socket :seconds 2)))
               (multiple-value-bind (dcid scid) (quic-retry-cids reply)
                 (unless (and reply dcid
                              (equalp dcid #(9 10 11 12 13 14 15 16))
                              (plusp (length scid))
                              (not (equalp scid #(1 2 3 4 5 6 7 8)))
                              (<= (length reply) (* 3 (length initial))))
                   (fail "reply ~s dcid ~s scid ~s" reply dcid scid))))
             (when (quic-recv-packet socket :seconds 0.4)
               (fail "a second datagram followed Retry")))
        (ignore-errors (sb-bsd-sockets:socket-close socket))))))

(defun quic-version-negotiation-test (port)
  (check "QUIC version negotiation"
    (let ((socket (make-instance 'sb-bsd-sockets:inet-socket :type :datagram :protocol :udp))
          (packet (make-array 1200 :element-type '(unsigned-byte 8) :initial-element 0)))
      (unwind-protect
           (progn
             (setf (sb-bsd-sockets:non-blocking-mode socket) t)
             ;; RFC 9000: a Version Negotiation packet is sent only for a
             ;; long-header datagram of at least 1200 bytes.
             (replace packet #(#xc0 #x0a #x0a #x0a #x0a
                               8 1 2 3 4 5 6 7 8
                               8 9 10 11 12 13 14 15 16))
             (sb-bsd-sockets:socket-send socket packet nil
                                         :address (list #(127 0 0 1) port))
             (let ((buffer (make-array 1500 :element-type '(unsigned-byte 8)))
                   (deadline (+ (get-internal-real-time) (* 2 internal-time-units-per-second)))
                   (got nil))
               (loop while (< (get-internal-real-time) deadline)
                     do (multiple-value-bind (buf len)
                            (handler-case
                                (sb-bsd-sockets:socket-receive socket buffer nil
                                                               :dontwait t
                                                               :element-type '(unsigned-byte 8))
                              (sb-bsd-sockets:interrupted-error ()
                                (values nil 0)))
                          (when (and buf len (>= len 7) (logtest (aref buf 0) #x80)
                                     (zerop (aref buf 1)) (zerop (aref buf 2))
                                     (zerop (aref buf 3)) (zerop (aref buf 4)))
                            (setf got buf)
                            (return)))
                        (sleep 0.02))
               (unless got
                 (fail "no version negotiation packet"))))
        (ignore-errors (sb-bsd-sockets:socket-close socket))))))

(defun ipv6-tests (certificate private-key)
  (call-with-server
   (lambda (server)
     (pazuzu:add-route server :get "/"
                       (lambda (request)
                         (declare (ignore request))
                         (pazuzu:text-response "pazuzu")))
     (check "IPv6 HTTP/1.1"
       (multiple-value-bind (version body)
           (curl-version (format nil "http://[::1]:~d/" (pazuzu::server-port server))
                         "--http1.1" "-g")
         (unless (string= version "1.1")
           (fail "version ~s body ~s" version body))
         (unless (and body (search "pazuzu" body))
           (fail "body ~s" body)))))
   :address "::1")
  (call-with-server
   (lambda (server)
     (pazuzu:add-route server :get "/"
                       (lambda (request)
                         (declare (ignore request))
                         (pazuzu:text-response "pazuzu")))
     (check "IPv6 HTTP/3"
       (multiple-value-bind (version body)
           (curl-version (format nil "https://[::1]:~d/" (pazuzu::server-port server))
                         "--http3-only" "-k" "-g")
         (unless (string= version "3")
           (fail "version ~s body ~s" version body))
         (unless (and body (search "pazuzu" body))
           (fail "body ~s" body))))
     (quic-dont-fragment-test server))
   :address "::1" :certificate certificate :private-key private-key))

(defun accept-thread-count ()
  (count-if (lambda (thread)
              (let ((name (ignore-errors (bt:thread-name thread))))
                (and name
                     (search "pazuzu-accept-" name)
                     (bt:thread-alive-p thread))))
            (bt:all-threads)))

(defun wait-until (predicate)
  (loop repeat 40
        when (funcall predicate)
          do (return t)
        do (sleep 0.05)))

(defun write-config (path plist)
  (with-open-file (out path :direction :output :if-exists :supersede :if-does-not-exist :create)
    (let ((*print-case* :downcase))
      (prin1 plist out))
    (terpri out)))

(defun file-text (path)
  (alexandria:read-file-into-string path))

(defun file-octets (path)
  (with-open-file (in path :element-type '(unsigned-byte 8))
    (let ((buffer (make-array (file-length in) :element-type '(unsigned-byte 8))))
      (read-sequence buffer in)
      buffer)))

(defun expect-file (reply path)
  (expect-status reply 200)
  (unless (equalp (reply-body reply) (file-octets path))
    (fail "body ~s is not ~a" (ignore-errors (body-text reply)) path))
  (let ((type (pazuzu::mime-type path)))
    (unless (string= (or (header reply "content-type") "") type)
      (fail "content-type ~s for ~a" (header reply "content-type") path))))

(defun write-utf8 (path text)
  (ensure-directories-exist path)
  (with-open-file (out path :direction :output :if-exists :supersede
                       :if-does-not-exist :create
                       :element-type '(unsigned-byte 8))
    (write-sequence (octets text) out)))

(defun logged-listen-port (text)
  (let ((mark (search "listening on" text :from-end t)))
    (when mark
      (let ((at (search " port " text :start2 mark)))
        (when at
          (parse-integer text :start (+ at 6) :junk-allowed t))))))

(defun exercise-config-main (config log file host path)
  (setf pazuzu::*shutdown-flag* nil)
  (let ((done nil)
        (err nil))
    (bt:make-thread
     (lambda ()
       (handler-case (pazuzu:main (list config))
         (error (condition) (setf err condition)))
       (setf done t))
     :name "pazuzu-config-main")
    (unless (wait-until (lambda ()
                          (and (probe-file log)
                               (search "listening on" (file-text log)))))
      (fail "no listener ~s" (ignore-errors (file-text log))))
    (let ((port (logged-listen-port (file-text log))))
      (unless port
        (fail "port ~s" (file-text log)))
      (expect-file (exchange port
                             (request-text (format nil "GET ~a HTTP/1.1" path)
                                           (format nil "Host: ~a" host)))
                   file))
    (require :sb-posix)
    (sb-posix:kill (sb-posix:getpid) sb-posix:sigterm)
    (unless (wait-until (lambda () done))
      (fail "main did not return, shutdown ~s" pazuzu::*shutdown-flag*))
    (when err
      (fail "main error ~a" err))))

