  (let ((reply (quic-recv-packet socket :seconds 2)))
    (and reply
         (logtest (aref reply 0) #x80)
         (= (aref reply 1) 0) (= (aref reply 2) 0)
         (= (aref reply 3) 0) (= (aref reply 4) 1))))

