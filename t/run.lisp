               (unless (wait-until (lambda () (= (pazuzu:worker-count server) 1)))
                 (fail "workers ~d" (pazuzu:worker-count server)))
               (unless (wait-until (lambda () (= (accept-thread-count) 1)))
                 (fail "acceptors ~d" (accept-thread-count)))))
