             (let ((reply (quic-recv-packet socket :seconds 2)))
               (multiple-value-bind (dcid scid versions) (quic-vn-cids reply)
                 (unless (and dcid
                              (equalp dcid #(9 10 11 12 13 14 15 16))
                              (equalp scid #(1 2 3 4 5 6 7 8))
