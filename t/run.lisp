                     "    ':scheme': 'http',"
                     "    ':authority': authority,"
                     "  });"
                     "  const chunks = [];"
                     "  let status = '';"
                     "  let modified = '';"
                     "  let date = '';"
                     "  req.on('response', (headers) => {"
                     "    status = String(headers[':status']);"
                     "    modified = headers['last-modified'] == null ? '' : String(headers['last-modified']);"
                     "    date = headers['date'] == null ? '' : String(headers['date']);"
                     "  });"
