                     "        stream_id = client._quic.get_next_available_stream_id()"
                     "        done = client._loop.create_future()"
                     "        client._waiters[stream_id] = done"
                     "        client._http.send_headers(stream_id, ["
                     "            (b':method', b'POST'),"
                     "            (b':scheme', b'https'),"
                     "            (b':authority', authority),"
