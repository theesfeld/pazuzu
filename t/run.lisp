                   "    crypto = quic._cryptos[Epoch.HANDSHAKE]"
                   "    dcid = quic._peer_cid.cid"
                   "    scid = quic.host_cid"
                   "    first = encode_long_header_first_byte(QuicProtocolVersion.VERSION_1, QuicPacketType.HANDSHAKE, 1)"
